#include <winver.h>
#include "../brand.h"
#include "../version.h"

1 VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_FILEVERSION
FILETYPE VFT_DLL
#if defined(RENODX_DLSS5_DEBUG)
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "OriginalFilename", "renodx-dlss5.addon64\0"
      VALUE "FileVersion", NR_NEXUS_VERSION "\0"
      VALUE "ProductVersion", NR_NEXUS_VERSION "\0"
      VALUE "ProductName", NR_NEXUS_NAME "\0"
      VALUE "FileDescription", NR_NEXUS_DESCRIPTION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
