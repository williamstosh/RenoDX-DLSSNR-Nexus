+// Compatibility candidate: borrowed canonical identity; keep the object (and its native
+// base) alive. Only ReShade is unwrapped: Streamline faces remain distinct.
+[[nodiscard]] inline IUnknown* NativeIdentity(IUnknown* object) {
+  if (object == nullptr) return nullptr;
+  NativeFromReShadeProxy(&object);
+  IUnknown* identity = nullptr;
+  if (FAILED(object->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&identity)))
+      || identity == nullptr) {
+    return nullptr;
+  }
+  identity->Release();
+  return identity;
+}
+
+[[nodiscard]] inline bool SameNativeObject(IUnknown* first, IUnknown* second) {
+  IUnknown* first_identity = NativeIdentity(first);
+  return first_identity != nullptr && first_identity == NativeIdentity(second);
+}
