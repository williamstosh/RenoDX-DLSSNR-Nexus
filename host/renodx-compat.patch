 namespace renodx::utils::vtable {
 
+// Compatibility candidate: this binary owns its statically linked Detours
+// state. Inline linkage unifies translation units, not independent add-ons.
+inline std::atomic<std::uint64_t> transaction_contended{0};
+
+[[nodiscard]] inline std::mutex& TransactionMutex() {
+  static std::mutex transaction_mutex;
+  return transaction_mutex;
+}
+
+// Caller holds TransactionMutex through UpdateThread and Commit/Abort.
+// A foreign owner is counted and left intact; callers choose retry policy.
+[[nodiscard]] inline bool BeginTransaction() {
+  const LONG result = DetourTransactionBegin();
+  if (result == ERROR_INVALID_OPERATION) {
+    transaction_contended.fetch_add(1, std::memory_order_relaxed);
+  }
+  return result == NO_ERROR;
+}
